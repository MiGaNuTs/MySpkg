#!/bin/sh

PACKAGE="gitsyncpkg"
PKG_DIR="/var/packages/${PACKAGE}/target"
DOCROOT="${PKG_DIR}/www"
PORT="8877"
PIDFILE="/var/packages/${PACKAGE}/var/httpd.pid"

start_daemon() {
    if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
        echo "Already running."
        return 0
    fi
    /bin/busybox httpd -f -p "${PORT}" -h "${DOCROOT}" &
    echo $! > "${PIDFILE}"
}

stop_daemon() {
    if [ -f "${PIDFILE}" ]; then
        PID="$(cat "${PIDFILE}")"
        if kill -0 "${PID}" 2>/dev/null; then
            kill "${PID}"
        fi
        rm -f "${PIDFILE}"
    fi
}

daemon_status() {
    if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

case "$1" in
    start)
        start_daemon
        exit 0
        ;;
    stop)
        stop_daemon
        exit 0
        ;;
    status)
        daemon_status
        exit $?
        ;;
    *)
        echo "Usage: $0 {start|stop|status}"
        exit 1
        ;;
esac
